#!/usr/bin/env node

import { accessSync, constants, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { delimiter, dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawn, spawnSync } from 'node:child_process';

const ownFile = fileURLToPath(import.meta.url);
const ownDir = dirname(ownFile);
const args = process.argv.slice(2);

if (args[0] === 'close-tab' && args.some((argument) => argument === '--help' || argument === '-h')) {
  process.stdout.write(
    'Usage: terminal-browser close-tab [tab-id ...]\n\n' +
    'Closes the active tab, or every listed tab id, in the browser owned by this agent-remote chat.\n' +
    'Tab ids are shown by `terminal-browser ls`.\n',
  );
  process.exit(0);
}

function executable(candidate) {
  if (!candidate || candidate === ownFile) return false;
  try {
    accessSync(candidate, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

function findRealBinary() {
  const explicit = process.env.TERMINAL_BROWSER_REAL;
  if (executable(explicit)) return explicit;

  const installedApp = join(homedir(), '.local', 'share', 'terminal-browser', 'app', 'bin', 'terminal-browser');
  if (executable(installedApp)) return installedApp;

  for (const directory of (process.env.PATH || '').split(delimiter)) {
    if (!directory || directory === ownDir) continue;
    const candidate = join(directory, 'terminal-browser');
    if (executable(candidate)) return candidate;
  }
  return null;
}

function runReal(commandArgs = args) {
  const binary = findRealBinary();
  if (!binary) {
    console.error('terminal-browser: real binary not found');
    process.exitCode = 127;
    return;
  }
  const child = spawn(binary, commandArgs, { stdio: 'inherit', env: process.env });
  child.once('error', (error) => {
    console.error(`terminal-browser: ${error.message}`);
    process.exitCode = 1;
  });
  child.once('exit', (code, signal) => {
    if (signal) process.kill(process.pid, signal);
    else process.exitCode = code ?? 1;
  });
}

function browserArguments() {
  const forwarded = [];
  const optionsWithValues = new Set(['--split', '--split-dir', '--size', '--parent-tty']);
  for (let index = 0; index < args.length; index += 1) {
    if (optionsWithValues.has(args[index])) {
      index += 1;
      continue;
    }
    if ([...optionsWithValues].some((option) => args[index].startsWith(`${option}=`))) continue;
    forwarded.push(args[index]);
  }
  return ['terminal-browser', ...forwarded];
}

function tmuxOutput(args) {
  const result = spawnSync(process.env.TMUX_COMMAND || 'tmux', args, {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  });
  return result.status === 0 ? result.stdout.trim() : '';
}

function ancestorTtys() {
  const ttys = new Set();
  let pid = process.pid;
  for (let depth = 0; depth < 16 && pid > 1; depth += 1) {
    const result = spawnSync('ps', ['-o', 'ppid=,tty=', '-p', String(pid)], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    });
    const match = result.stdout?.trim().match(/^(\d+)\s+(\S+)$/);
    if (!match) break;
    const tty = match[2];
    if (tty !== '??' && tty !== '-') ttys.add(tty.split('/').at(-1));
    pid = Number(match[1]);
  }
  return ttys;
}

function detectTmuxSession() {
  const explicit = process.env.AGENT_REMOTE_SESSION;
  if (explicit) return explicit;

  if (process.env.TMUX_PANE) {
    const session = tmuxOutput(['display-message', '-p', '-t', process.env.TMUX_PANE, '#{session_name}']);
    if (session) return session;
  }

  const ttys = ancestorTtys();
  if (ttys.size === 0) return '';
  const panes = tmuxOutput(['list-panes', '-a', '-F', '#{pane_tty}\t#{session_name}']);
  for (const line of panes.split('\n')) {
    const [paneTty, session] = line.split('\t');
    if (paneTty && session && ttys.has(paneTty.split('/').at(-1))) return session;
  }
  return '';
}

function controlTarget() {
  // A shared Grok leader keeps the tmux environment of the first chat that
  // started it, but each tool subprocess receives the current Grok thread id.
  // Prefer that immutable owner so chat B cannot mutate chat A's browser.
  const threadId = process.env.GROK_SESSION_ID?.trim();
  if (threadId && threadId.length <= 160) return { threadId };
  const session = detectTmuxSession();
  return session ? { session } : { cwd: process.cwd() };
}

async function deliverToBackend(pathname, body, timeoutMs = 5_000) {
  const base = process.env.AGENT_REMOTE_URL || 'http://127.0.0.1:3000';
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), timeoutMs);
  const headers = { 'content-type': 'application/json' };
  if (process.env.AGENT_REMOTE_TOKEN) headers.authorization = `Bearer ${process.env.AGENT_REMOTE_TOKEN}`;

  try {
    const response = await fetch(new URL(pathname, base), {
      method: 'POST',
      headers,
      body: JSON.stringify(body),
      signal: controller.signal,
    });
    let payload = null;
    try { payload = await response.json(); } catch {}
    return {
      ok: response.ok,
      payload,
      error: response.ok ? undefined : payload?.error || `agent-remote returned ${response.status}`,
    };
  } catch {
    return undefined;
  } finally {
    clearTimeout(timeout);
  }
}

function newTabUrl() {
  for (let index = 1; index < args.length; index += 1) {
    if (args[index] === '--browser') {
      index += 1;
      continue;
    }
    if (!args[index].startsWith('-')) return args[index];
  }
  return undefined;
}

function closeTabIds() {
  const ids = [];
  for (let index = 1; index < args.length; index += 1) {
    let value = args[index];
    if (value === '--tab') value = args[++index];
    else if (value?.startsWith('--tab=')) value = value.slice(6);
    if (!/^\d+$/.test(value || '') || Number(value) <= 0 || Number(value) > Number.MAX_SAFE_INTEGER) return undefined;
    ids.push(Number(value));
  }
  return [...new Set(ids)];
}

function deliverOscFallback(argv) {
  const request = Buffer.from(JSON.stringify({ argv })).toString('base64url');
  const sequence = `\x1b]777;agent-remote-split:${request}\x1b\\`;
  let control = sequence;
  if (process.env.TMUX) {
    spawnSync(process.env.TMUX_COMMAND || 'tmux', ['set-option', '-p', 'allow-passthrough', 'on'], { stdio: 'ignore' });
    control = `\x1bPtmux;${sequence.replaceAll('\x1b', '\x1b\x1b')}\x1b\\`;
  }
  try {
    writeFileSync('/dev/tty', control);
  } catch {
    process.stdout.write(control);
  }
}

function isManagedAgentRemoteContext() {
  return process.env.AGENT_REMOTE_WEB === '1' ||
    process.env.AGENT_REMOTE_ACP === '1' ||
    Boolean(process.env.AGENT_REMOTE_SESSION) ||
    process.env.TERM_PROGRAM === 'agent-remote';
}

function reportBackendUnavailable() {
  console.error('terminal-browser: the agent-remote backend is unavailable; wait for it to reconnect and try again');
  process.exitCode = 1;
}

const opensBrowser = args[0] === 'open' || (
  args[0] &&
  !args[0].startsWith('-') &&
  !['action', 'close-tab', 'ls', 'new-tab', 'setup', 'shutdown', 'upgrade'].includes(args[0])
);
const opensTab = args[0] === 'new-tab' && !args.some((argument) =>
  argument === '--browser' || argument.startsWith('--browser='),
);
const closesTab = args[0] === 'close-tab' && !args.some((argument) =>
  argument === '--browser' || argument.startsWith('--browser='),
);
const proxiesAction = args[0] === 'action' && !args.some((argument) =>
  argument === '--browser' || argument.startsWith('--browser=') || argument === '--help' || argument === '-h',
);
const proxiesList = args[0] === 'ls';
if (process.env.AGENT_REMOTE_GRAPHICS === '1' ||
    (!opensBrowser && !opensTab && !closesTab && !proxiesAction && !proxiesList)) {
  runReal();
} else {
  const target = controlTarget();
  const managedContext = isManagedAgentRemoteContext();
  // Agent tool subprocesses may intentionally strip tmux and AGENT_REMOTE_*
  // variables. Always give the local backend one chance to match the current
  // project directory; commands outside agent-remote still fall back to the
  // real terminal-browser when no matching backend is available.
  if (proxiesAction) {
    const payload = { argv: args.slice(1), ...target };
    const delivered = await deliverToBackend('/api/control/browser-action', payload, 35_000);
    if (delivered?.ok) {
      if (delivered.payload?.stderr) process.stderr.write(delivered.payload.stderr);
      if (delivered.payload?.stdout) process.stdout.write(delivered.payload.stdout);
    } else if (delivered) {
      console.error(`terminal-browser: ${delivered.error || 'no browser is open for this chat'}`);
      process.exitCode = 1;
    } else if (managedContext) reportBackendUnavailable();
    else runReal();
  } else if (proxiesList) {
    const base = process.env.AGENT_REMOTE_URL || 'http://127.0.0.1:3000';
    const endpoint = new URL('/api/control/browser-state', base);
    for (const [key, value] of Object.entries(target)) endpoint.searchParams.set(key, value);
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5_000);
    try {
      const headers = {};
      if (process.env.AGENT_REMOTE_TOKEN) headers.authorization = `Bearer ${process.env.AGENT_REMOTE_TOKEN}`;
      const response = await fetch(endpoint, { headers, signal: controller.signal });
      let payload = null;
      try { payload = await response.json(); } catch {}
      if (response.ok) process.stdout.write(`${JSON.stringify(payload, null, args.includes('--json') ? 2 : 0)}\n`);
      else {
        console.error(`terminal-browser: ${payload?.error || `agent-remote returned ${response.status}`}`);
        process.exitCode = 1;
      }
    } catch {
      if (managedContext) reportBackendUnavailable();
      else runReal();
    } finally {
      clearTimeout(timeout);
    }
  } else if (closesTab) {
    const tabs = closeTabIds();
    if (!tabs) {
      console.error('terminal-browser: close-tab accepts only positive integer tab ids');
      process.exitCode = 1;
    } else {
      const payload = { action: 'close-tab', ...target };
      if (tabs.length) payload.tabs = tabs;
      const delivered = await deliverToBackend('/api/control/browser-tab', payload);
      if (delivered?.ok) {
        const count = delivered.payload?.closed?.length || tabs.length || 1;
        process.stdout.write(count === 1
          ? '\r\nClosed the browser tab.\r\n'
          : `\r\nClosed ${count} browser tabs.\r\n`);
      } else if (delivered) {
        console.error(`terminal-browser: ${delivered.error || 'the browser tab could not be closed'}`);
        process.exitCode = 1;
      } else if (managedContext) reportBackendUnavailable();
      else {
        console.error('terminal-browser: close-tab requires an agent-remote browser');
        process.exitCode = 1;
      }
    }
  } else if (opensTab) {
    const url = newTabUrl();
    const payload = { action: 'new-tab', ...target };
    if (url) payload.url = url;
    const delivered = await deliverToBackend('/api/control/browser-tab', payload);
    if (delivered?.ok) {
      process.stdout.write(delivered.payload?.reused
        ? '\r\nFocused the existing agent-remote browser tab.\r\n'
        : '\r\nOpened a new tab in the existing agent-remote browser pane.\r\n');
    } else if (!delivered) {
      const argv = ['terminal-browser', 'open', ...(url ? [url] : [])];
      const splitPayload = { argv, waitForReady: true, ...target };
      const opened = await deliverToBackend('/api/control/split', splitPayload, 60_000);
      if (opened?.ok || (process.env.AGENT_REMOTE_WEB === '1' && process.env.AGENT_REMOTE_ACP !== '1')) {
        if (!opened?.ok) deliverOscFallback(argv);
        process.stdout.write('\r\nOpened terminal-browser in the agent-remote right pane.\r\n');
      } else if (opened) {
        console.error(`terminal-browser: ${opened.error}`);
        process.exitCode = 1;
      } else if (managedContext) {
        reportBackendUnavailable();
      } else {
        runReal();
      }
    } else {
      console.error(`terminal-browser: ${delivered.error}`);
      process.exitCode = 1;
    }
  } else {
    const argv = browserArguments();
    const payload = { argv, waitForReady: true, ...target };
    const delivered = await deliverToBackend('/api/control/split', payload, 60_000);
    if (delivered?.ok) {
      process.stdout.write('\r\nOpened terminal-browser in the agent-remote right pane.\r\n');
    } else if (delivered) {
      console.error(`terminal-browser: ${delivered.error}`);
      process.exitCode = 1;
    } else if (process.env.AGENT_REMOTE_WEB === '1') {
      if (process.env.AGENT_REMOTE_ACP === '1') {
        console.error('terminal-browser: no active agent-remote chat matches this project folder');
        process.exitCode = 1;
      } else {
        deliverOscFallback(argv);
        process.stdout.write('\r\nOpened terminal-browser in the agent-remote right pane.\r\n');
      }
    } else if (managedContext) {
      reportBackendUnavailable();
    } else {
      runReal();
    }
  }
}
