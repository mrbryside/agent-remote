{
  "name": "agent-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-remote": "bin/agent-remote.js"
  },
  "description": "Browser terminal backed by node-pty, with optional tmux session sharing.",
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty.js",
    "prestart": "node scripts/ensure-terminal-browser-shim.js",
    "predev": "node scripts/ensure-terminal-browser-shim.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "session": "node bin/agent-remote.js",
    "desktop:prepare": "node scripts/prepare-tauri-sidecars.js",
    "sidecar:build": "node scripts/prepare-tauri-sidecars.js --server",
    "sidecar:smoke": "node scripts/smoke-sidecar.js",
    "desktop:dev": "npm run desktop:prepare && npm run sidecar:build && tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "npm run desktop:prepare && npm run sidecar:build && tauri build --config src-tauri/tauri.conf.json",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/addon-image": "0.10.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "dompurify": "3.4.13",
    "marked": "18.0.10",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.4",
    "@yao-pkg/pkg": "^6.22.0",
    "node": "22.23.2"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js",
      "bin/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "node_modules/@xterm/xterm/lib/**/*",
      "node_modules/@xterm/xterm/css/**/*",
      "node_modules/@xterm/addon-fit/lib/**/*",
      "node_modules/@xterm/addon-image/lib/**/*",
      "node_modules/@highlightjs/cdn-assets/es/highlight.min.js",
      "node_modules/marked/lib/marked.esm.js",
      "node_modules/dompurify/dist/purify.es.mjs",
      "node_modules/node-pty/prebuilds/darwin-arm64/**/*"
    ],
    "targets": ["node22-macos-arm64"]
  },
  "engines": {
    "node": ">=22.5"
  }
}
